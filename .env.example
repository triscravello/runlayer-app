# RunLayer environment template.
# Copy to `.env` and fill in real values. Never commit `.env` or put real secrets in this file.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/runlayer

# Secret used to sign session cookies.
# - NODE_ENV=development (`npm run dev`): optional. A built-in, publicly known fallback is used if unset.
# - Any other NODE_ENV (production, test, staging, ...): REQUIRED, at least 32 characters,
#   and it must not be the development fallback.
# Generate one with:  openssl rand -base64 48
# Use a freshly generated value for each deployed environment; never reuse your local one.
BETTER_AUTH_SECRET=

# OpenWeather API key, used by the weather client (api.openweathermap.org).
# Weather lookups fail with an error if it is missing.
WEATHER_API_KEY=

# Rate limiting backend: "memory" or "upstash".
# - Development / test: optional, defaults to "memory".
# - Production: REQUIRED. There is no default; an unset or invalid value is rejected.
# "memory" is PROCESS-LOCAL: each server process keeps its own counters, they reset on restart, and they
# are not shared between instances. It is NOT equivalent to distributed rate limiting and is not
# sufficient for a multi-instance production deployment.
# "upstash" uses Upstash Redis (REST) shared across instances and requires both credentials below.
RATE_LIMIT_BACKEND=

# Upstash Redis REST credentials. Used ONLY when RATE_LIMIT_BACKEND=upstash (both are then required;
# setting them alone does not enable Upstash).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How the app identifies the client IP for rate limiting: "none", "header:<name>" or "xff-hops:<n>".
# - Development / test: optional, defaults to "none".
# - Production: REQUIRED. There is no default; an unset or invalid value is rejected.
# Forwarding headers are client-controlled unless a proxy YOU operate overwrites or appends to them, so
# nothing is trusted by default:
#   none           Reads no header. Every request gets the same identifier ("unknown"), so all clients share
#                  one rate-limit bucket. Use for local development, or when the app is not behind a trusted proxy.
#   header:<name>  Trusts one single-address header (for example header:x-real-ip). Use ONLY if a hosting proxy
#                  sets and OVERWRITES that header on every request and clients cannot bypass the proxy.
#   xff-hops:<n>   Uses the n-th entry from the RIGHT of X-Forwarded-For (n = 1-10). Use ONLY if you have
#                  verified that exactly n trusted proxies each append the address they saw. A wrong n selects
#                  a proxy address or a client-controlled value.
# Values that are not a valid IPv4/IPv6 address (ports, brackets, lists, oversized values) resolve to "unknown".
CLIENT_IP_STRATEGY=

# Bearer token required by GET /api/metrics ("Authorization: Bearer <token>"). Server-side only; never expose
# it with a NEXT_PUBLIC_ prefix.
# - Unset in development (NODE_ENV=development): the endpoint is open, so the local Prometheus/Grafana
#   workflow works without configuration.
# - Unset in any other environment (production, staging, test, ...): the endpoint returns 404 (disabled).
# - Set: must be 32-256 characters of letters, digits and - . _ ~ + / (optionally ending in =); every
#   request must present it. An invalid value also disables the endpoint (404).
# Generate one with:  openssl rand -base64 48
# To scrape it with the local Prometheus stack, see docker-compose.observability.auth.yml.
METRICS_TOKEN=

# --- Optional ---------------------------------------------------------------

# Redis connection URL (ioredis). Used ONLY as a response cache for POST /api/recommend.
# If unset or unreachable the app runs without the cache. It does NOT enable rate limiting.
REDIS_URL=

# Winston log level (default: info).
LOG_LEVEL=

# Set to "true" to print recommendation-engine diagnostics (always on when NODE_ENV=development).
RECOMMENDATION_DEBUG=

# --- Seeding (do NOT put these in .env) ---------------------------------------
#
# Seeding is only allowed against a dedicated LOCAL database; hosted databases are always refused and there is no
# override. Put the three variables below in a separate, git-ignored file named `.env.seed.local`, then run
# `npm run db:seed:check` (read-only, makes no connection) and `npm run db:seed:local`.
#
#   DATABASE_URL=postgresql://localhost:5432/runlayer_dev   # loopback/local socket only; name must start with "runlayer"
#   RUNLAYER_SEED_CONFIRM_DATABASE=runlayer_dev             # must equal the database name above, exactly
#   SEED_USER_PASSWORD=                                      # required: 12-128 characters, not predictable; no default
#
# See "Seeding safely" in the README.

# --- Guarded migrations and preflight (do NOT put these in .env) ----------------------------------------------------
#
# `npm run db:preflight`, `npm run db:deploy` and `npm run db:deploy:execute` never read DATABASE_URL and never read this
# file. Supply the values in the shell for the single command, from a secret store, and do not keep a production connection
# string in `.env`:
#
#   RUNLAYER_PREFLIGHT_TARGET_URL=         preflight only: the connection URL to inspect (read-only; prefer a read-only role)
#   RUNLAYER_MIGRATE_TARGET_URL=           migrate: the connection URL to migrate (direct or session-mode, never a transaction pooler)
#   RUNLAYER_DB_ALLOWED_TARGETS=           exact host:port/database entries the operator approves; no wildcards
#   RUNLAYER_MIGRATE_CONFIRM_TARGET=       the target's host:port/database, typed again
#   RUNLAYER_MIGRATE_EVIDENCE_MAX_AGE_MINUTES=   optional; 1-240, default 30
#
# See docs/first-deployment-runbook.md.
