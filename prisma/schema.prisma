// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BodyType {
  SLIM
  ATHLETIC
  BROAD
  PLUS
}

enum BudgetLevel {
  BUDGET
  MID
  PREMIUM
}

enum Category {
  TOP
  BOTTOM
  ACCESSORY
}

enum PriceRange {
  BUDGET
  MID
  PREMIUM
}

enum ConditionKey {
  HOT
  COLD
  RAIN
  WIND
  HUMID
  NIGHT
}

enum UserRole {
  USER
  ADMIN
}

enum RecommendationFeedbackType {
  HELPFUL
  NOT_HELPFUL
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String @map("password_hash")

  role UserRole @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  profile                UserProfile?
  recommendations        Recommendation[]
  savedOutfits           SavedOutfit[]
  recommendationFeedback RecommendationFeedback[]

  @@map("users")
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  heightCm  Int? @map("height_cm")
  weightLbs Int? @map("weight_lbs")

  bodyType        BodyType? @map("body_type")
  heatSensitivity String?   @map("heat_sensitivity")
  heatTolerance   String?   @map("heat_tolerance")
  coldTolerance   String?   @map("cold_tolerance")
  chafeProne      Boolean   @default(false) @map("chafe_prone")

  stylePreference   String?      @map("style_preference")
  budgetLevel       BudgetLevel? @map("budget_level")
  budgetSensitivity String?      @map("budget_sensitivity")
  preferredFit      String?      @map("preferred_fit")
  terrainPreference String?      @map("terrain_preference")
  preferredBrands   String[]     @default([]) @map("preferred_brands")
  avoidedBrands     String[]     @default([]) @map("avoided_brands")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model WeatherSnapshot {
  id String @id @default(uuid())

  location  String
  latitude  Float?
  longitude Float?

  tempF               Float? @map("temp_f")
  humidity            Float?
  windSpeed           Float? @map("wind_speed")
  precipitationChance Float? @map("precipitation_chance")
  uvIndex             Float? @map("uv_index")

  condition    String?
  tempCategory String? @map("temp_category")

  createdAt DateTime @default(now()) @map("created_at")

  recommendations Recommendation[]

  @@map("weather_snapshots")
}

model GearItem {
  id String @id @default(uuid())

  name    String
  brandId String @map("brand_id")
  brand   Brand  @relation(fields: [brandId], references: [id])

  genderTarget String? @map("gender_target")

  category    Category
  subcategory String?

  priceRange PriceRange

  tags String[]

  weatherHot  Float? @map("weather_hot")
  weatherCold Float? @map("weather_cold")
  weatherRain Float? @map("weather_rain")
  weatherWind Float? @map("weather_wind")

  bodyTypeFit String[] @map("body_type_fit")

  imageUrl     String? @map("image_url")
  affiliateUrl String? @map("affiliate_url")

  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at")
  OutfitItem         OutfitItem[]
  RecommendationItem RecommendationItem[]

  @@unique([name, brandId])
  @@map("gear_items")
}

model Brand {
  id   String @id @default(uuid())
  name String @unique

  tier  String?
  style String?

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  GearItem  GearItem[]

  @@map("brands")
}

model Recommendation {
  id String @id @default(uuid())

  userId            String  @map("user_id")
  weatherSnapshotId String? @map("weather_snapshot_id")

  inputContext     Json     @map("input_context")
  output           Json
  topScore         Float?   @map("top_score")
  algorithmVersion String?  @map("algorithm_version")
  engineVersion    String   @default("1.0.0") @map("engine_version")
  generatedAt      DateTime @default(now()) @map("generated_at")

  createdAt DateTime @default(now()) @map("created_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  weatherSnapshot WeatherSnapshot? @relation(fields: [weatherSnapshotId], references: [id])

  savedOutfits    SavedOutfit[]
  items           RecommendationItem[]
  versionMetadata RecommendationVersionMetadata?

  @@index([engineVersion])
  @@index([generatedAt])
  @@map("recommendations")
}

model RecommendationVersionMetadata {
  id String @id @default(uuid())

  recommendationId String   @unique @map("recommendation_id")
  engineVersion    String   @map("engine_version")
  timestamp        DateTime @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([engineVersion])
  @@map("recommendation_version_metadata")
}

model RecommendationItem {
  id String @id @default(uuid())

  recommendationId String @map("recommendation_id")
  gearItemId       String @map("gear_item_id")

  rank       Int
  totalScore Float @map("total_score")
  breakdown  Json

  createdAt DateTime @default(now()) @map("created_at")

  recommendation Recommendation           @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  gearItem       GearItem                 @relation(fields: [gearItemId], references: [id], onDelete: Cascade)
  feedback       RecommendationFeedback[]

  @@unique([recommendationId, gearItemId])
  @@map("recommendation_items")
}

model RecommendationFeedback {
  id String @id @default(uuid())

  recommendationId String                     @map("recommendation_id")
  userId           String                     @map("user_id")
  feedbackType     RecommendationFeedbackType @map("feedback_type")

  createdAt DateTime @default(now()) @map("created_at")

  recommendation RecommendationItem @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, userId])
  @@map("recommendation_feedback")
}

model SavedOutfit {
  id String @id @default(uuid())

  userId           String  @map("user_id")
  recommendationId String? @map("recommendation_id")

  name        String?
  description String?
  type        String  @default("custom")
  isFavorite  Boolean @default(false) @map("is_favorite")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id])
  OutfitItem     OutfitItem[]

  @@map("saved_outfits")
}

model OutfitItem {
  id String @id @default(uuid())

  outfitId   String @map("outfit_id")
  gearItemId String @map("gear_item_id")

  category Category?

  outfit   SavedOutfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  gearItem GearItem    @relation(fields: [gearItemId], references: [id], onDelete: Cascade)

  @@map("outfit_items")
}

model RecommendationRule {
  id String @id @default(uuid())

  conditionKey ConditionKey @map("condition_key")
  category     Category?

  weight Float

  tags String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("recommendation_rules")
}
